# OpenAI-compatible upstream. The URL must end in /v1.
UPSTREAM_API_BASE=https://example.com/v1
UPSTREAM_API_KEY=replace-with-your-upstream-key

# Must match OPENAI_API_KEY in ~/.codex/auth.json. The default is suitable
# when this proxy remains bound to 127.0.0.1.
LITELLM_MASTER_KEY=local-litellm-proxy

# The proxy is published only to 127.0.0.1.
HOST_PORT=4000

# Optional: override here where Docker Hub is unavailable.
# PYTHON_IMAGE=127.0.0.1:5000/foundation/base/python:3.13.14-slim-bookworm

# Optional: Python package mirror. Uncomment for mainland China:
#   Tsinghua:   https://pypi.tuna.tsinghua.edu.cn/simple
#   Aliyun:     https://mirrors.aliyun.com/pypi/simple
#   Tencent:    https://mirrors.cloud.tencent.com/pypi/simple
#   USTC:       https://pypi.mirrors.ustc.edu.cn/simple
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Optional: pip version used in the build stage.
# PIP_VERSION=26.1.2
